  <object-name>mfd1bezel</object-name>  
  <object-name>mfd1knob0</object-name>
  <object-name>mfd1knob1</object-name>
  
  <!-- VEMD, MFD2-->
  <object-name>vemd.face</object-name> 
  <object-name>xmfd2bg</object-name>
  
  <!-- CAD, MFD3 -->
  <object-name>cad.face</object-name>
  <object-name>xmfd3bg</object-name>
  
  <!-- Engine Control Panel-->
  <object-name>ecp.face</object-name>
  <object-name>base</object-name>
  <object-name>base.001</object-name>
  <object-name>base.002</object-name>
  <object-name>base.003</object-name>
  <object-name>base.004</object-name>
  <object-name>main1</object-name>
  <object-name>main2</object-name>
  
  <!-- standby ADI static parts -->
  <object-name>adi.button</object-name>
  <object-name>adi.mount</object-name>
  <object-name>adi.ring</object-name>
  <object-name>adi.scale</object-name>
  <object-name>adi.plane</object-name>
  <!-- standby ALT static parts -->
  <object-name>alt.button</object-name>
  <object-name>alt.mount</object-name>
  <object-name>alt.ring</object-name>
  <!-- standby IAS  static parts -->
  <object-name>ias.mount</object-name>
  <object-name>ias.ring</object-name>
  <!-- clock static parts -->
  <object-name>clock.mount</object-name>
  <object-name>clock.ring</object-name>
  <!-- tachimeter static parts -->
  <object-name>tach.mount</object-name>
  <object-name>tach.ring</object-name>
  
  <!-- other main panel objects, vent nozzle, push buttons, ..-->
  <object-name>vent0.1</object-name>
  <object-name>vent0.2</object-name>
  <object-name>vent0.3</object-name>
  <object-name>vent0.4</object-name>
  <object-name>vent1.1</object-name>
  <object-name>vent1.2</object-name>
  <object-name>vent1.3</object-name>
  <object-name>vent1.4</object-name>
  
  <object-name>PB.000</object-name>
  <object-name>PB.001</object-name>
  <object-name>PB.002</object-name>
  <object-name>PB.003</object-name>
  <object-name>PB.004</object-name>
  <object-name>PB.005</object-name>
  <object-name>callsgn.001</object-name>
  <object-name>callsgn.000</object-name>
  
</effect>

 <!-- the mfd screen needs to be emissive to see the canvas,
      the screen contents are included as canvas via Nasal -->

 <animation> 
    <type>material</type> 
    <object-name>xmfd0screen</object-name>
    <object-name>xmfd1screen</object-name>
    <object-name>xmfd2screen</object-name>
    <emission>
      <red>1.0</red>
      <green>1.0</green>
      <blue>1.0</blue>
<!--       <factor-prop>controls/lighting/instrument-lights-norm</factor-prop> -->
    </emission>    
    <ambient>
      <red>0.0</red>
      <green>0.0</green>
      <blue>0.0</blue>
    </ambient>
    <diffuse>
      <red>0.0</red>
      <green>0.0</green>
      <blue>0.0</blue>
    </diffuse>
 </animation>
 

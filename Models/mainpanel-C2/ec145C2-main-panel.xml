<?xml version="1.0"?>

<PropertyList>
  <path>ec145C2-main-panel.ac</path>
  
  <animation>
        <type>range</type>
        <min-m>0</min-m>
        <max-m>150</max-m>
    </animation>

  <effect>
      <inherits-from>Aircraft/ec145/Models/Effects/implicit-lightmap</inherits-from> 
      <object-name>ecp.face</object-name>
  </effect>
  
  <!-- ALS display effect for the MFD screen object , needs FG 2018.3+-->

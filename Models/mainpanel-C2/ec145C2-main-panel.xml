      <inherits-from>Aircraft/ec145/Models/Effects/mfd-screen</inherits-from> 
      <object-name>xmfd0screen</object-name>
      <object-name>xmfd1screen</object-name>
      <object-name>xmfd2screen</object-name>
      <object-name>xmfd3screen</object-name>
  </effect>

<!-- interior shadows on main instrument panel -->
<effect>
  <inherits-from>Aircraft/ec145/Models/Effects/bk117panel-shadows</inherits-from>
  <object-name>panel</object-name>
  
  <!-- MFD0, pilot (screen background included in shadow effect)-->

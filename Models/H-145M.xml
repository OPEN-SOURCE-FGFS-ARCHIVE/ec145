    <center>
      <x-m>-2.005</x-m>
      <y-m>0.0</y-m>
      <z-m>-0.355</z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
 </animation> 


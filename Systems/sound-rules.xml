                            <property>/engines/engine[0]/n2-pct</property>
                            <entry><ind> 78</ind><dep> 1</dep></entry>
                            <entry><ind>100</ind><dep>10</dep></entry>
                        </table>
                    </log10>
                    <log10>
                        <table>
                            <property>/engines/engine[0]/n1-pct</property>
                            <entry><ind>71</ind><dep>10</dep></entry>
                            <entry><ind>80</ind><dep> 1</dep></entry>
                        </table>
                    </log10>
                </product>
            </expression>
        </input>
        <output>
            <property>/sounds/H145/engines/engine0-flight-idle</property>
        </output>
    </filter>

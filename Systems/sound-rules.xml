    <!-- Main Rotor -->
    <filter>
        <name>rotor-in</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <expression>
                <log10>
                    <table>
                        <property>/rotors/main/rpm</property>
                        <entry><ind>  5.09295817894</ind><dep> 1</dep></entry>
                        <entry><ind>383            </ind><dep>10</dep></entry>
                    </table>
                </log10>
            </expression>
        </input>
        <output>
            <property>/sounds/H145/rotors/rotor-in</property>
        </output>
    </filter>

    <!-- Blade vortex interaction -->
    <filter>
        <name>IGE</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <expression>
                <product>
                    <property>/sounds/H145/rotors/rotor-in</property>
                    <log10>
                        <table>
                            <property>/position/gear-agl-m</property>
                            <entry><ind> 0</ind><dep>10</dep></entry>
                            <entry><ind>11</ind><dep> 1</dep></entry>
                        </table>
                    </log10>
                </product>
            </expression>
        </input>
        <output>
            <property>/sounds/H145/rotors/IGE</property>
        </output>
    </filter>
    <filter>
        <name>OGE</name>
        <type>gain</type>
        <gain>1.0</gain>
        <input>
            <expression>
                <product>
                    <property>/sounds/H145/rotors/rotor-in</property>
                    <log10>
                        <table>
                            <property>/position/gear-agl-m</property>
                            <entry><ind> 0</ind><dep> 1</dep></entry>
                            <entry><ind>11</ind><dep>10</dep></entry>
                        </table>
                    </log10>
                </product>
            </expression>
        </input>
        <output>
            <property>/sounds/H145/rotors/OGE</property>
        </output>
    </filter>

    <filter>
        <type>moving-average</type>
        <samples>60</samples>
        <input>/rotors/main/blade[0]/flap-deg</input>
        <output>/rotors/main/blade[0]/avg-flap-deg</output>
    </filter>
    <filter>
        <type>moving-average</type>
        <samples>30</samples>
        <input>/rotors/main/blade[0]/incidence-deg</input>
        <output>/rotors/main/blade[0]/avg-incidence-deg</output>
    </filter>
    <filter>
        <type>moving-average</type>
        <samples>60</samples>
        <input>/rotors/main/blade[2]/flap-deg</input>
        <output>/rotors/main/blade[2]/avg-flap-deg</output>
    </filter>
    <filter>
        <type>moving-average</type>
        <samples>30</samples>
        <input>/rotors/main/blade[2]/incidence-deg</input>
        <output>/rotors/main/blade[2]/avg-incidence-deg</output>
    </filter>

    <filter>
        <type>gain</type>
        <gain>0.5</gain>
        <input>
            <expression>
                <sum>
                    <!-- Blade 0 in ground effect -->
                    <product>
                        <table>
                            <property>/rotors/main/blade[0]/avg-flap-deg</property>
                            <entry><ind>0.0</ind><dep>0.0</dep></entry>
                            <entry><ind>2.8</ind><dep>1.0</dep></entry>
                        </table>
                        <table>
                            <property>/rotors/main/blade[0]/avg-incidence-deg</property>
                            <entry><ind>0.0</ind><dep>0.0</dep></entry>
                            <entry><ind>8.5</ind><dep>1.0</dep></entry>
                        </table>
                        <table>
                            <property>/position/gear-agl-m</property>
                            <entry><ind> 0.0</ind><dep>1.0</dep></entry>
                            <entry><ind>11  </ind><dep>0.0</dep></entry>
                        </table>
                        <table>
                            <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                            <entry><ind> 0  </ind><dep>1.0</dep> </entry>
                            <entry><ind>30.0</ind><dep>0.0</dep></entry>
                        </table>
                    </product>
                    <!-- Blade 0 out of ground effect -->
                    <product>
                        <table>
                            <property>/rotors/main/blade[0]/avg-flap-deg</property>
                            <entry><ind>2.8</ind><dep>0.0</dep></entry>
                            <entry><ind>3.2</ind><dep>1.0</dep></entry>
                        </table>
                        <table>
                            <property>/rotors/main/blade[0]/avg-incidence-deg</property>
                            <entry><ind>0.0</ind><dep>0.0</dep></entry>
                            <entry><ind>9.0</ind><dep>1.0</dep></entry>
                        </table>
                        <table>
                            <property>/position/gear-agl-m</property>
                            <entry><ind> 0.0</ind><dep>0.0</dep></entry>
                            <entry><ind>11  </ind><dep>1.0</dep></entry>
                        </table>
                        <table>
                            <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                            <entry><ind> 0  </ind><dep>0.0</dep></entry>
                            <entry><ind>30.0</ind><dep>1.0</dep></entry>
                            <entry><ind>60.0</ind><dep>1.0</dep></entry>
                            <entry><ind>90.0</ind><dep>0.0</dep></entry>
                        </table>
                    </product>
                    <!-- Blade 2 in ground effect -->
                    <product>
                        <table>
                            <property>/rotors/main/blade[2]/avg-flap-deg</property>
                            <entry><ind>0.0</ind><dep>0.0</dep></entry>
                            <entry><ind>2.8</ind><dep>1.0</dep></entry>
                        </table>
                        <table>
                            <property>/rotors/main/blade[2]/avg-incidence-deg</property>
                            <entry><ind>0.0</ind><dep>0.0</dep></entry>
                            <entry><ind>8.5</ind><dep>1.0</dep></entry>
                        </table>
                        <table>
                            <property>/position/gear-agl-m</property>
                            <entry><ind> 0.0</ind><dep>1.0</dep></entry>
                            <entry><ind>11  </ind><dep>0.0</dep></entry>
                        </table>
                        <table>
                            <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                            <entry><ind> 0  </ind><dep>1.0</dep></entry>
                            <entry><ind>30.0</ind><dep>0.0</dep></entry>
                        </table>
                    </product>
                    <!-- Blade 2 out of ground effect -->
                    <product>
                        <table>
                            <property>/rotors/main/blade[2]/avg-flap-deg</property>
                            <entry><ind>2.8</ind><dep>0.0</dep></entry>
                            <entry><ind>3.2</ind><dep>1.0</dep></entry>
                        </table>
                        <table>
                            <property>/rotors/main/blade[2]/avg-incidence-deg</property>
                            <entry><ind>0.0</ind><dep>0.0</dep></entry>
                            <entry><ind>9.0</ind><dep>1.0</dep></entry>
                        </table>
                        <table>
                            <property>/position/gear-agl-m</property>
                            <entry><ind> 0.0</ind><dep>0.0</dep></entry>
                            <entry><ind>11  </ind><dep>1.0</dep></entry>
                        </table>
                        <table>
                            <property>/instrumentation/airspeed-indicator/indicated-speed-kt</property>
                            <entry><ind> 0  </ind><dep>0.0</dep></entry>
                            <entry><ind>30.0</ind><dep>1.0</dep></entry>
                            <entry><ind>60.0</ind><dep>1.0</dep></entry>
                            <entry><ind>90.0</ind><dep>0.0</dep></entry>
                        </table>
                    </product>
                </sum>
            </expression>
        </input>
        <output>
            <property>/sounds/H145/rotors/main/blade-vortex-interaction</property>
        </output>
    </filter>

